---
interface Profile {
  name: string;
  institution: string;
  classYear: string;
  department: string;
  role: string;
  signature: string;
}

interface Props {
  profile: Profile;
}

const { profile } = Astro.props;
---

<section class="hero section">
  <div class="container">

    <!-- Cyrillic watermark accent (parallax, slow) -->
    <div class="hero__watermark" data-parallax="0.35" aria-hidden="true">КВАНТ</div>

    <div class="hero__content">
      <!-- Institution line -->
      <span class="hero__meta" data-reveal data-reveal-delay="0">
        {profile.institution} · {profile.classYear} · {profile.department}
      </span>

      <!-- Main name -->
      <h1 class="hero__name" data-reveal data-reveal-delay="0.1">
        <span class="hero__name-text">{profile.name}</span>
      </h1>

      <!-- Role -->
      <p class="hero__role" data-reveal data-reveal-delay="0.2">{profile.role}</p>

      <!-- Divider + Signature -->
      <div class="hero__footer" data-reveal data-reveal-delay="0.35">
        <div class="hero__line"></div>
        <p class="hero__signature">「{profile.signature}」</p>
      </div>
    </div>

    <!-- Decorative elements -->
    <div class="hero__deco hero__deco--star" data-parallax="0.15" aria-hidden="true">★</div>
    <div class="hero__deco hero__deco--url" aria-hidden="true">lsqkk.github.io</div>

    <!-- Crop marks -->
    <div class="crop-mark crop-mark--tl" aria-hidden="true"></div>
    <div class="crop-mark crop-mark--tr" aria-hidden="true"></div>
    <div class="crop-mark crop-mark--bl" aria-hidden="true"></div>
    <div class="crop-mark crop-mark--br" aria-hidden="true"></div>

    <!-- Scroll indicator -->
    <div class="hero__scroll" aria-hidden="true">
      <span class="hero__scroll-arrow">→</span>
      <span class="hero__scroll-label">scroll</span>
    </div>
  </div>
</section>

<style>
  .hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding-top: 0;
    padding-bottom: 0;
    isolation: isolate;
  }

  .hero .container {
    width: 100%;
  }

  /* Cyrillic accent watermark */
  .hero__watermark {
    position: absolute;
    font-family: var(--font-display);
    font-size: clamp(6rem, 16vw, 12rem);
    color: rgba(17, 17, 17, 0.035);
    text-transform: uppercase;
    letter-spacing: 0.2em;
    bottom: -0.15em;
    right: -0.05em;
    line-height: 1;
    user-select: none;
    pointer-events: none;
    z-index: -1;
  }

  /* Misregistration ghost */
  .hero__watermark::after {
    content: 'КВАНТ';
    position: absolute;
    color: rgba(204, 0, 0, 0.04);
    top: 2px;
    left: -3px;
    pointer-events: none;
  }

  .hero__content {
    position: relative;
    max-width: 820px;
  }

  /* Meta / institution */
  .hero__meta {
    font-family: var(--font-body);
    font-size: clamp(0.7rem, 1vw, 0.9rem);
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--red);
    display: inline-block;
    margin-bottom: 1.8rem;
    border-left: 4px solid var(--red);
    padding-left: 14px;
  }

  /* Main name */
  .hero__name {
    font-size: clamp(3.2rem, 10vw, 7.5rem);
    margin-bottom: 0.3rem;
    position: relative;
    display: inline-block;
  }

  .hero__name-text {
    position: relative;
    z-index: 1;
  }

  /* Red block highlight behind name */
  .hero__name::after {
    content: '';
    position: absolute;
    bottom: 0.08em;
    left: -0.02em;
    width: 110%;
    height: 0.2em;
    background: var(--red);
    opacity: 0.2;
    z-index: 0;
  }

  /* Role */
  .hero__role {
    font-family: var(--font-display);
    font-size: clamp(1.1rem, 2.2vw, 1.8rem);
    letter-spacing: 0.35em;
    text-transform: uppercase;
    color: var(--black-soft);
    margin-bottom: 2.5rem;
  }

  /* Divider */
  .hero__line {
    width: 90px;
    height: 4px;
    background: var(--black);
    margin-bottom: 0.8rem;
  }

  /* Signature */
  .hero__signature {
    font-size: clamp(0.85rem, 1.1vw, 1.05rem);
    color: var(--black);
    opacity: 0.55;
    letter-spacing: 0.02em;
  }

  /* Decorative star */
  .hero__deco--star {
    position: absolute;
    font-size: 1.2rem;
    color: var(--red);
    top: 20%;
    right: 15%;
    opacity: 0.3;
  }

  /* Decorative URL text */
  .hero__deco--url {
    position: absolute;
    font-family: var(--font-body);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--black);
    opacity: 0.15;
    bottom: 12%;
    right: 5%;
    transform: rotate(-90deg);
    transform-origin: right center;
    white-space: nowrap;
  }

  /* ---- Scroll Indicator ---- */
  .hero__scroll {
    position: absolute;
    bottom: 32px;
    right: 6vw;
    display: flex;
    align-items: center;
    gap: 8px;
    opacity: 0.25;
    writing-mode: vertical-rl;
  }

  .hero__scroll-arrow {
    display: inline-block;
    font-family: var(--font-display);
    font-size: 1rem;
    animation: scroll-bounce 2s ease-in-out infinite;
  }

  .hero__scroll-label {
    font-family: var(--font-display);
    font-size: 0.6rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
  }

  @keyframes scroll-bounce {
    0%, 100% { transform: translateY(0);    opacity: 0.6; }
    50%      { transform: translateY(6px);  opacity: 1;   }
  }

  @media (max-width: 768px) {
    .hero { min-height: 80vh; }
    .hero__deco--url { display: none; }
    .hero__deco--star { right: 8%; }
  }
</style>

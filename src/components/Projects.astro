---
interface Project {
  name: string;
  description: string;
  url: string;
  featured?: boolean;
  tags?: string[];
}

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;
const featured = projects.find(p => p.featured);
const others = projects.filter(p => !p.featured);
---

<section class="projects section section-alt">
  <div class="container">
    <h2 class="section-title" data-reveal>ПРОЕКТЫ</h2>
    <p class="projects__sub" data-reveal>Проекты · 项目</p>

    <div class="projects__grid">
      <!-- Featured project (largest) -->
      {
        featured && (
          <a href={featured.url} class="project-card project-card--featured" target="_blank" rel="noopener noreferrer" data-reveal>
            <div class="project-card__marker" aria-hidden="true">★ 精选</div>
            <div class="project-card__body">
              <h3 class="project-card__title">{featured.name}</h3>
              <p class="project-card__desc">{featured.description}</p>
            </div>
            <div class="project-card__meta">
              {featured.tags?.map(tag => <span class="tag">{tag}</span>)}
              <span class="project-card__arrow">→</span>
            </div>
            <!-- Decorator shapes -->
            <div class="project-card__deco" aria-hidden="true"></div>
            <div class="crop-mark crop-mark--tl"></div>
            <div class="crop-mark crop-mark--br"></div>
          </a>
        )
      }

      <!-- Other projects -->
      {
        others.map((project, i) => (
          <a
            href={project.url}
            class="project-card"
            target="_blank"
            rel="noopener noreferrer"
            data-reveal
          >
            <div class="project-card__body">
              <h3 class="project-card__title">{project.name}</h3>
              <p class="project-card__desc">{project.description}</p>
            </div>
            <div class="project-card__meta">
              {project.tags?.map(tag => <span class="tag">{tag}</span>)}
              <span class="project-card__arrow">→</span>
            </div>
            <div class="crop-mark crop-mark--tl"></div>
            <div class="crop-mark crop-mark--br"></div>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* --- Sub-header --- */
  .projects__sub {
    font-family: var(--font-body);
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--gold-dark);
    margin-bottom: 3rem;
    margin-top: -1.8rem;
  }

  /* --- Grid --- */
  .projects__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }

  /* Featured spans 2 columns, 2 rows */
  .project-card--featured {
    grid-column: span 2;
    grid-row: span 2;
    border: var(--border-thicker) solid var(--red);
    min-height: 300px;
    position: relative;
    z-index: 1;
  }

  /* Misregistration effect — offset "ghost" border for rough print feel */
  .project-card--featured::before {
    content: '';
    position: absolute;
    inset: -10px -8px -6px -10px;
    border: 3px solid var(--black);
    opacity: 0.12;
    pointer-events: none;
    z-index: -1;
  }

  /* --- Individual Card --- */
  .project-card {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    border: var(--border-thick) solid var(--black);
    padding: 24px;
    background: var(--white-off);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
    min-height: 180px;
    text-decoration: none;
    color: inherit;
  }

  .project-card:hover {
    transform: translate(-4px, -4px);
    box-shadow: 8px 8px 0 var(--black);
  }

  .project-card--featured:hover {
    transform: translate(-5px, -5px);
    box-shadow: 10px 10px 0 var(--red);
  }

  /* --- Card Body --- */
  .project-card__body {
    flex: 1;
  }

  .project-card__title {
    font-family: var(--font-display);
    font-size: clamp(1.1rem, 1.6vw, 1.5rem);
    letter-spacing: 0.04em;
    margin-bottom: 0.5rem;
    line-height: 1.2;
  }

  .project-card--featured .project-card__title {
    font-size: clamp(1.6rem, 2.8vw, 2.4rem);
  }

  .project-card__desc {
    font-size: clamp(0.75rem, 0.9vw, 0.85rem);
    color: var(--black);
    opacity: 0.6;
    line-height: 1.5;
    max-width: 90%;
  }

  /* --- Card Meta (bottom) --- */
  .project-card__meta {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 1rem;
  }

  .project-card__arrow {
    margin-left: auto;
    font-size: 1.2rem;
    transition: transform 0.2s ease;
  }

  .project-card:hover .project-card__arrow {
    transform: translateX(4px);
  }

  /* --- Tags --- */
  .tag {
    font-family: var(--font-body);
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 3px 8px;
    border: 2px solid var(--black);
    color: var(--black);
  }

  .project-card--featured .tag {
    border-color: var(--red);
    color: var(--red);
  }

  /* --- Featured marker badge --- */
  .project-card__marker {
    position: absolute;
    top: 12px;
    right: 12px;
    font-family: var(--font-display);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    color: var(--red);
    opacity: 0.6;
  }

  /* --- Featured decorative shape --- */
  .project-card__deco {
    position: absolute;
    bottom: 12px;
    right: 12px;
    width: 40px;
    height: 40px;
    border: 3px solid var(--red);
    border-radius: 50%;
    opacity: 0.15;
    pointer-events: none;
  }

  /* --- Responsive Grid --- */
  @media (max-width: 1024px) {
    .projects__grid { grid-template-columns: repeat(3, 1fr); }
    .project-card--featured { grid-column: span 2; grid-row: span 1; }
  }

  @media (max-width: 768px) {
    .projects__grid { grid-template-columns: repeat(2, 1fr); }
    .project-card--featured { grid-column: span 2; }
  }

  @media (max-width: 500px) {
    .projects__grid { grid-template-columns: 1fr; }
    .project-card--featured { grid-column: span 1; grid-row: span 1; min-height: 220px; }
    .project-card__desc { max-width: 100%; }
  }
</style>

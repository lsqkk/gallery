<section class="opensource section" id="opensource">
  <div class="container">
    <h2 class="section-title" data-reveal>ОТКРЫТЫЙ РЕПОЗИТОРИЙ</h2>
    <p class="opensource__sub" data-reveal>Открытый репозиторий · 开源仓库</p>
  </div>

  <div class="proun-stage" id="proun-stage">
    <div class="proun-grid-bg" aria-hidden="true"></div>

    <div class="proun-scene" id="proun-scene">
      <div class="proun-cylinder" id="proun-cylinder">
        <div class="opensource__loading" id="gh-loading">
          <span class="opensource__loading-dot">●</span>
          <span class="opensource__loading-dot">●</span>
          <span class="opensource__loading-dot">●</span>
        </div>
      </div>
      <div class="proun-fade" aria-hidden="true"></div>
      <div class="proun-spotlight" aria-hidden="true"></div>
    </div>
  </div>
</section>

<script>
(function() {
  var EXCLUDED = ['guide-vehicle', 'lsqkk.github.io', 'image', 'lsqkk', 'gallery'];
  var cylinder = document.getElementById('proun-cylinder');
  var loading = document.getElementById('gh-loading');
  var scene = document.getElementById('proun-scene');

  var LANG_COLORS = {
    'JavaScript': '#f1e05a',
    'TypeScript': '#3178c6',
    'Python': '#3572A5',
    'HTML': '#e34c26',
    'CSS': '#563d7c',
    'Java': '#b07219',
    'C': '#555555',
    'C++': '#f34b7d',
    'Shell': '#89e051',
    'Rust': '#dea584',
    'Go': '#00ADD8',
    'Vue': '#42b883',
    'Astro': '#ff5a03',
  };

  function langColor(lang) {
    return LANG_COLORS[lang] || '#6b6b6b';
  }

  async function loadRepos() {
    try {
      var res = await fetch('https://api.github.com/users/lsqkk/repos?sort=updated&per_page=30&type=owner');
      if (!res.ok) throw new Error('HTTP ' + res.status);
      var repos = await res.json();

      var filtered = repos
        .filter(function(r) { return !EXCLUDED.includes(r.name) && !r.fork; })
        .sort(function(a, b) { return b.stargazers_count - a.stargazers_count; });

      if (filtered.length === 0) {
        loading.textContent = '— No repositories —';
        return;
      }

      loading.style.display = 'none';

      var count = filtered.length;
      var angleStep = 360 / count;

      filtered.forEach(function(repo, i) {
        var angle = i * angleStep;
        var col = langColor(repo.language);

        var item = document.createElement('a');
        item.href = repo.html_url;
        item.target = '_blank';
        item.rel = 'noopener noreferrer';
        item.className = 'proun-item';
        item.style.setProperty('--a', angle.toFixed(1) + 'deg');
        item.style.setProperty('--col', col);

        var shortName = repo.name.length > 16 ? repo.name.slice(0, 14) + '…' : repo.name;
        var desc = repo.description || '—';

        item.innerHTML =
          '<span class="proun-item__stripe" style="background:' + col + '"></span>' +
          '<span class="proun-item__inner">' +
            '<span class="proun-item__top">' +
              '<span class="proun-item__name">' + escapeHtml(shortName) + '</span>' +
              '<span class="proun-item__stars">★ ' + repo.stargazers_count + '</span>' +
            '</span>' +
            (repo.language ? '<span class="proun-item__lang"><span class="proun-item__dot" style="background:' + col + '"></span>' + repo.language + '</span>' : '') +
            '<span class="proun-item__hover">' +
              '<span class="proun-item__desc">' + escapeHtml(desc) + '</span>' +
              '<span class="proun-item__foot">' +
                (repo.forks_count > 0 ? '<span>⑂ ' + repo.forks_count + '</span>' : '') +
                '<span>' + formatDate(repo.updated_at) + '</span>' +
                '<span class="proun-item__arrow">→</span>' +
              '</span>' +
            '</span>' +
          '</span>' +
          '<span class="crop-mark crop-mark--tl"></span>' +
          '<span class="crop-mark crop-mark--br"></span>';

        cylinder.appendChild(item);
      });

      // ——— Red Stars ———
      for (var s = 0; s < 14; s++) {
        var star = document.createElement('span');
        star.className = 'proun-star';
        star.textContent = '★';
        star.style.left = (1 + Math.random() * 98) + '%';
        star.style.top = (2 + Math.random() * 95) + '%';
        star.style.fontSize = (5 + Math.random() * 18) + 'px';
        star.style.animationDelay = (Math.random() * 7).toFixed(2) + 's';
        star.style.animationDuration = (3 + Math.random() * 4).toFixed(1) + 's';
        star.style.opacity = '0.06';
        scene.appendChild(star);
      }

      // ——— 3D Cylinder Auto-Rotation ———
      var rotation = 0;
      var isPaused = false;
      var isDragging = false;
      var dragStartX = 0;
      var dragStartRot = 0;
      var SPEED = 0.12; // deg/frame ≈ 1 rotation / 50s

      function tick() {
        if (!isPaused && !isDragging) {
          rotation = (rotation + SPEED) % 360;
        }
        cylinder.style.setProperty('--rot', rotation.toFixed(2) + 'deg');
        requestAnimationFrame(tick);
      }

      requestAnimationFrame(tick);

      scene.addEventListener('mouseenter', function() { isPaused = true; });
      scene.addEventListener('mouseleave', function() {
        isPaused = false;
        isDragging = false;
      });

      scene.addEventListener('mousedown', function(e) {
        if (e.target.closest('a')) return;
        isDragging = true;
        isPaused = true;
        dragStartX = e.clientX;
        dragStartRot = rotation;
      });

      window.addEventListener('mousemove', function(e) {
        if (!isDragging) return;
        var dx = e.clientX - dragStartX;
        rotation = ((dragStartRot + dx * 0.35) % 360 + 360) % 360;
      });

      window.addEventListener('mouseup', function() {
        if (isDragging) {
          isDragging = false;
          isPaused = false;
        }
      });

      scene.addEventListener('touchstart', function(e) {
        if (e.target.closest('a')) return;
        isDragging = true;
        isPaused = true;
        dragStartX = e.touches[0].clientX;
        dragStartRot = rotation;
      }, { passive: true });

      scene.addEventListener('touchmove', function(e) {
        if (!isDragging) return;
        var dx = e.touches[0].clientX - dragStartX;
        rotation = ((dragStartRot + dx * 0.35) % 360 + 360) % 360;
      }, { passive: true });

      scene.addEventListener('touchend', function() {
        if (isDragging) {
          isDragging = false;
          isPaused = false;
        }
      });

    } catch (err) {
      loading.textContent = '— Failed to load repositories —';
    }
  }

  function formatDate(dateStr) {
    if (!dateStr) return '';
    var d = new Date(dateStr);
    var now = new Date();
    var diff = Math.floor((now - d) / (1000 * 60 * 60 * 24));
    if (diff === 0) return 'today';
    if (diff === 1) return 'yesterday';
    if (diff < 30) return diff + 'd ago';
    return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
  }

  function escapeHtml(str) {
    var div = document.createElement('div');
    div.appendChild(document.createTextNode(str));
    return div.innerHTML;
  }

  loadRepos();
})();
</script>

<style is:global>
  .opensource__sub {
    font-family: var(--font-body);
    font-size: 0.95rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--gold-dark);
    margin-bottom: 3rem;
    margin-top: -1.8rem;
  }

  /* ============================================
     Proun Stage — 3D Cylinder Carousel
     ============================================ */
  .proun-stage {
    position: relative;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 4vw;
    height: 500px;
    overflow: hidden;
  }

  .proun-grid-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0.22;
    background-image:
      repeating-linear-gradient(
        28deg,
        transparent 0px,
        transparent 39px,
        rgba(196, 164, 74, 0.08) 40px
      ),
      repeating-linear-gradient(
        -28deg,
        transparent 0px,
        transparent 39px,
        rgba(196, 164, 74, 0.08) 40px
      );
  }

  /* ——— 3D Scene ——— */
  .proun-scene {
    position: absolute;
    inset: 0;
    perspective: 1300px;
    perspective-origin: 50% 48%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: grab;
  }
  .proun-scene:active { cursor: grabbing; }

  /* Cylinder radius, overridable per breakpoint */
  .proun-cylinder {
    --R: 480px;
    width: 0;
    height: 0;
    transform-style: preserve-3d;
    transform: rotateY(var(--rot, 0deg));
  }

  /* ——— Card ——— */
  .proun-item {
    position: absolute;
    display: block;
    width: 170px;
    height: 132px;
    margin-left: -85px;
    margin-top: -66px;
    backface-visibility: hidden;
    transform: rotateY(var(--a, 0deg)) translateZ(var(--R));
    text-decoration: none;
    color: inherit;
    cursor: pointer;
    border: 2px solid var(--black);
    background: var(--white-warm);
    box-shadow: -2px 2px 0 rgba(17, 17, 17, 0.06);
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1),
                box-shadow 0.3s ease,
                border-color 0.25s ease;
  }

  /* ——— Hover ——— */
  .proun-item:hover {
    transform: rotateY(var(--a, 0deg)) translateZ(var(--R)) scale(1.22);
    box-shadow: -10px 10px 0 var(--col, var(--gold));
    border-color: var(--col, var(--gold));
    z-index: 999;
  }

  .proun-item:hover .proun-item__stripe { width: 6px; }
  .proun-item:hover .proun-item__hover { opacity: 1; }
  .proun-item:hover .proun-item__arrow { transform: translateX(4px); opacity: 1; }

  /* ——— Card inner layout ——— */
  .proun-item__stripe {
    position: absolute;
    top: 0;
    left: 0;
    width: 4px;
    height: 100%;
    transition: width 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .proun-item__inner {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 14px 12px 8px 16px;
    position: relative;
  }

  .proun-item__top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 6px;
  }

  .proun-item__name {
    font-family: var(--font-display);
    font-size: 0.82rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--black);
    word-break: break-word;
    line-height: 1.2;
  }

  .proun-item__stars {
    font-family: var(--font-body);
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--gold-dark);
    white-space: nowrap;
    flex-shrink: 0;
    margin-top: 2px;
  }

  .proun-item__lang {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-family: var(--font-body);
    font-size: 0.65rem;
    font-weight: 500;
    color: var(--black);
    opacity: 0.4;
    margin-top: auto;
    padding-top: 4px;
  }

  .proun-item__dot {
    display: inline-block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  /* ——— Hover description overlay ——— */
  .proun-item__hover {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 18px 12px 8px 16px;
    background: linear-gradient(to top,
      var(--white-warm) 0%,
      var(--white-warm) 55%,
      transparent 100%);
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
  }

  .proun-item__desc {
    font-family: var(--font-body);
    font-size: 0.68rem;
    color: var(--black);
    opacity: 0.8;
    margin: 0 0 4px;
    line-height: 1.45;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .proun-item__foot {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-body);
    font-size: 0.58rem;
    color: var(--black);
    opacity: 0.5;
  }

  .proun-item__arrow {
    margin-left: auto;
    font-size: 0.8rem;
    color: var(--red);
    opacity: 0.6;
    transition: transform 0.25s ease, opacity 0.25s ease;
  }

  /* ——— Edge fade vignette ——— */
  .proun-fade {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(
      to right,
      var(--white-off) 0%,
      transparent 14%,
      transparent 86%,
      var(--white-off) 100%
    );
    z-index: 2;
  }

  /* ——— Center spotlight ——— */
  .proun-spotlight {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 400px;
    height: 400px;
    margin: -200px 0 0 -200px;
    pointer-events: none;
    background: radial-gradient(ellipse, rgba(196, 164, 74, 0.05) 0%, transparent 70%);
    z-index: 0;
  }

  /* ============================================
     Red Stars
     ============================================ */
  .proun-star {
    position: absolute;
    color: var(--red);
    pointer-events: none;
    user-select: none;
    line-height: 1;
    animation: proun-star-drift 4s ease-in-out infinite;
    will-change: transform, opacity;
    text-shadow: 0 0 10px rgba(204, 0, 0, 0.35), 0 0 2px rgba(204, 0, 0, 0.15);
    z-index: 3;
  }

  @keyframes proun-star-drift {
    0%, 100% { opacity: 0.06; transform: translateY(0) scale(1); }
    35% { opacity: 0.22; transform: translateY(-8px) scale(1.15); }
    65% { opacity: 0.15; transform: translateY(-4px) scale(1.05); }
  }

  /* ============================================
     Loading
     ============================================ */
  .opensource__loading {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    display: flex;
    gap: 8px;
    font-family: var(--font-body);
    font-size: 1rem;
    letter-spacing: 0.3em;
    color: var(--black);
    opacity: 0.25;
  }

  .opensource__loading-dot {
    animation: dot-pulse 1.4s ease-in-out infinite;
  }
  .opensource__loading-dot:nth-child(2) { animation-delay: 0.2s; }
  .opensource__loading-dot:nth-child(3) { animation-delay: 0.4s; }

  @keyframes dot-pulse {
    0%, 80%, 100% { opacity: 0.2; transform: scale(0.8); }
    40% { opacity: 0.8; transform: scale(1.1); }
  }

  /* ============================================
     Responsive
     ============================================ */
  @media (max-width: 860px) {
    .proun-stage { height: 380px; }
    .proun-scene { perspective: 1000px; }
    .proun-cylinder { --R: 360px; }
    .proun-item { width: 140px; height: 108px; margin-left: -70px; margin-top: -54px; }
    .proun-item__inner { padding: 10px 10px 6px 14px; }
    .proun-item__name { font-size: 0.7rem; }
    .proun-item__stars { font-size: 0.6rem; }
    .proun-item__lang { font-size: 0.55rem; }
    .proun-item__hover { display: none; }
    .proun-star { display: none; }
    .proun-grid-bg { opacity: 0.12; }
  }

  @media (max-width: 540px) {
    .proun-stage { height: 280px; }
    .proun-scene { perspective: 700px; }
    .proun-cylinder { --R: 240px; }
    .proun-item { width: 100px; height: 78px; margin-left: -50px; margin-top: -39px; border-width: 1.5px; }
    .proun-item__inner { padding: 7px 7px 4px 10px; }
    .proun-item__name { font-size: 0.55rem; }
    .proun-item__stars { font-size: 0.48rem; }
    .proun-item__lang { display: none; }
    .proun-item__stripe { width: 3px; }
    .proun-item:hover { transform: rotateY(var(--a)) translateZ(var(--R)) scale(1.15); box-shadow: -4px 4px 0 var(--col, var(--gold)); }
    .proun-item .crop-mark { width: 12px; height: 12px; border-width: 2px; }
    .proun-spotlight { width: 200px; height: 200px; margin: -100px 0 0 -100px; }
    .proun-fade { background: linear-gradient(to right, var(--white-off) 0%, transparent 10%, transparent 90%, var(--white-off) 100%); }
  }
</style>

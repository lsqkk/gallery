<section class="opensource section" id="opensource">
  <div class="container">
    <h2 class="section-title" data-reveal>ОТКРЫТЫЙ РЕПОЗИТОРИЙ</h2>
    <p class="opensource__sub" data-reveal>Открытый репозиторий · 开源仓库</p>
  </div>

  <div class="proun-scene" id="proun-scene">
    <div class="proun-grid-bg" aria-hidden="true"></div>

    <div class="proun-grid" id="gh-repos">
      <div class="opensource__loading" id="gh-loading">
        <span class="opensource__loading-dot">●</span>
        <span class="opensource__loading-dot">●</span>
        <span class="opensource__loading-dot">●</span>
      </div>
    </div>
  </div>
</section>

<script>
(function() {
  var EXCLUDED = ['guide-vehicle', 'lsqkk.github.io', 'image', 'lsqkk', 'gallery'];
  var grid = document.getElementById('gh-repos');
  var loading = document.getElementById('gh-loading');
  var scene = document.getElementById('proun-scene');

  var LANG_COLORS = {
    'JavaScript': '#f1e05a',
    'TypeScript': '#3178c6',
    'Python': '#3572A5',
    'HTML': '#e34c26',
    'CSS': '#563d7c',
    'Java': '#b07219',
    'C': '#555555',
    'C++': '#f34b7d',
    'Shell': '#89e051',
    'Rust': '#dea584',
    'Go': '#00ADD8',
    'Vue': '#42b883',
    'Astro': '#ff5a03',
  };

  function langColor(lang) {
    return LANG_COLORS[lang] || '#6b6b6b';
  }

  async function loadRepos() {
    try {
      var res = await fetch('https://api.github.com/users/lsqkk/repos?sort=updated&per_page=30&type=owner');
      if (!res.ok) throw new Error('HTTP ' + res.status);
      var repos = await res.json();

      var filtered = repos
        .filter(function(r) { return !EXCLUDED.includes(r.name) && !r.fork; })
        .sort(function(a, b) { return b.stargazers_count - a.stargazers_count; });

      if (filtered.length === 0) {
        loading.textContent = '— No repositories —';
        return;
      }

      loading.style.display = 'none';

      var total = filtered.length;

      filtered.forEach(function(repo, i) {
        var sizeClass;
        if (i < 2) sizeClass = 'proun-item--xl';
        else if (i < 6) sizeClass = 'proun-item--lg';
        else if (i < 14) sizeClass = 'proun-item--md';
        else sizeClass = 'proun-item--sm';

        var rot = (Math.random() - 0.5) * (sizeClass === 'proun-item--xl' ? 2 : sizeClass === 'proun-item--lg' ? 3 : sizeClass === 'proun-item--md' ? 5 : 6);
        var yOff = Math.floor(Math.random() * 16 - 8);

        var col = langColor(repo.language);

        var item = document.createElement('a');
        item.href = repo.html_url;
        item.target = '_blank';
        item.rel = 'noopener noreferrer';
        item.className = 'proun-item ' + sizeClass;
        item.setAttribute('data-reveal', '');
        item.style.setProperty('--rot', rot.toFixed(1) + 'deg');
        item.style.setProperty('--y', yOff + 'px');
        item.style.setProperty('--color', col);

        // Darken language color for the hover border accent
        // Use the color as-is — it works with the constructivist palette

        var desc = repo.description || '—';
        var shortName = repo.name.length > 16 ? repo.name.slice(0, 14) + '…' : repo.name;

        item.innerHTML =
          '<span class="proun-item__stripe" style="background:' + col + '"></span>' +
          '<div class="proun-item__body">' +
            '<div class="proun-item__top">' +
              '<span class="proun-item__name">' + escapeHtml(shortName) + '</span>' +
              '<span class="proun-item__stars">★ ' + repo.stargazers_count + '</span>' +
            '</div>' +
            (repo.language ? '<span class="proun-item__lang"><span class="proun-item__dot" style="background:' + col + '"></span>' + repo.language + '</span>' : '') +
          '</div>' +
          '<div class="proun-item__hover">' +
            '<p class="proun-item__desc">' + escapeHtml(desc) + '</p>' +
            '<div class="proun-item__foot">' +
              (repo.forks_count > 0 ? '<span class="proun-item__fork">⑂ ' + repo.forks_count + '</span>' : '') +
              '<span class="proun-item__update">' + formatDate(repo.updated_at) + '</span>' +
              '<span class="proun-item__arrow">→</span>' +
            '</div>' +
          '</div>' +
          '<span class="crop-mark crop-mark--tl"></span>' +
          '<span class="crop-mark crop-mark--br"></span>';

        grid.appendChild(item);
      });

      // ——— Floating Red Stars (decorative, Option 4 blend) ———
      for (var s = 0; s < 7; s++) {
        (function() {
          var star = document.createElement('span');
          star.className = 'proun-star';
          star.textContent = '★';
          star.style.left = (5 + Math.random() * 88) + '%';
          star.style.top = (4 + Math.random() * 88) + '%';
          star.style.fontSize = (10 + Math.random() * 22) + 'px';
          star.style.animationDelay = (Math.random() * 4).toFixed(2) + 's';
          star.style.animationDuration = (3 + Math.random() * 2).toFixed(1) + 's';
          star.style.opacity = '0.08';
          scene.appendChild(star);
        })();
      }

      // Trigger reveal
      requestAnimationFrame(function() {
        var observer = new IntersectionObserver(function(entries) {
          entries.forEach(function(entry) {
            if (entry.isIntersecting) {
              entry.target.classList.add('revealed');
              observer.unobserve(entry.target);
            }
          });
        }, { threshold: 0.06, rootMargin: '0px 0px -40px 0px' });
        grid.querySelectorAll('.proun-item').forEach(function(el) {
          observer.observe(el);
        });
      });

    } catch (err) {
      loading.textContent = '— Failed to load repositories —';
    }
  }

  function formatDate(dateStr) {
    if (!dateStr) return '';
    var d = new Date(dateStr);
    var now = new Date();
    var diff = Math.floor((now - d) / (1000 * 60 * 60 * 24));
    if (diff === 0) return 'today';
    if (diff === 1) return 'yesterday';
    if (diff < 30) return diff + 'd ago';
    return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
  }

  function escapeHtml(str) {
    var div = document.createElement('div');
    div.appendChild(document.createTextNode(str));
    return div.innerHTML;
  }

  loadRepos();
})();
</script>

<style is:global>
  .opensource__sub {
    font-family: var(--font-body);
    font-size: 0.95rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--gold-dark);
    margin-bottom: 3rem;
    margin-top: -1.8rem;
  }

  /* ——— Proun Scene ——— */
  .proun-scene {
    position: relative;
    max-width: 1160px;
    margin: 0 auto;
    padding: 0 6vw 60px;
    min-height: 320px;
  }

  /* Isometric grid background */
  .proun-grid-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0.35;
    background-image:
      repeating-linear-gradient(
        28deg,
        transparent 0px,
        transparent 41px,
        rgba(196, 164, 74, 0.10) 42px
      ),
      repeating-linear-gradient(
        -28deg,
        transparent 0px,
        transparent 41px,
        rgba(196, 164, 74, 0.10) 42px
      );
  }

  /* ——— Proun Grid (4-col bento) ——— */
  .proun-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
    position: relative;
    z-index: 1;
  }

  /* ——— Proun Item ——— */
  .proun-item {
    position: relative;
    display: flex;
    flex-direction: column;
    border: 2px solid var(--black);
    background: var(--white-warm);
    text-decoration: none;
    color: inherit;
    cursor: pointer;
    transition:
      transform 0.4s cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 0.4s cubic-bezier(0.16, 1, 0.3, 1),
      border-color 0.3s ease;
    transform: rotate(var(--rot, 0deg)) translateY(var(--y, 0px));
    opacity: 0;
    transform-style: preserve-3d;
    will-change: transform;
  }

  .proun-item.revealed {
    opacity: 1;
  }

  .proun-item--xl {
    grid-column: span 2;
    grid-row: span 2;
    min-height: 240px;
  }

  .proun-item--lg {
    grid-column: span 2;
    min-height: 130px;
  }

  .proun-item--md {
    min-height: 110px;
  }

  .proun-item--sm {
    min-height: 90px;
  }

  /* Language color stripe (left) */
  .proun-item__stripe {
    position: absolute;
    top: 0;
    left: 0;
    width: 5px;
    height: 100%;
    transition: width 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* ——— Body ——— */
  .proun-item__body {
    flex: 1;
    display: flex;
    flex-direction: column;
    padding: 16px 18px 12px 22px;
  }

  .proun-item--xl .proun-item__body {
    padding: 24px 26px 18px 30px;
  }

  .proun-item__top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 10px;
  }

  .proun-item__name {
    font-family: var(--font-display);
    font-size: clamp(0.85rem, 1.1vw, 1rem);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--black);
    word-break: break-word;
    line-height: 1.2;
  }

  .proun-item--xl .proun-item__name {
    font-size: clamp(1.1rem, 1.6vw, 1.35rem);
  }

  .proun-item--xl .proun-item__top {
    margin-bottom: 8px;
  }

  .proun-item__stars {
    font-family: var(--font-body);
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--gold-dark);
    white-space: nowrap;
    flex-shrink: 0;
    margin-top: 2px;
  }

  .proun-item__lang {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-family: var(--font-body);
    font-size: 0.72rem;
    font-weight: 500;
    color: var(--black);
    opacity: 0.5;
    margin-top: auto;
    padding-top: 6px;
  }

  .proun-item__dot {
    display: inline-block;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  /* ——— Hover reveal panel ——— */
  .proun-item__hover {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: var(--white-off);
    border-top: 2px solid var(--color, var(--gold));
    padding: 10px 18px 12px 22px;
    transform: translateY(100%);
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    z-index: 5;
  }

  .proun-item--xl .proun-item__hover {
    padding: 14px 26px 16px 30px;
  }

  .proun-item__desc {
    font-family: var(--font-body);
    font-size: clamp(0.75rem, 0.9vw, 0.82rem);
    color: var(--black);
    opacity: 0.75;
    margin: 0 0 8px;
    line-height: 1.55;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .proun-item__foot {
    display: flex;
    align-items: center;
    gap: 12px;
    font-family: var(--font-body);
    font-size: 0.68rem;
    color: var(--black);
    opacity: 0.45;
  }

  .proun-item__fork {
    display: inline-flex;
    align-items: center;
    gap: 2px;
  }

  .proun-item__update {
    margin-right: auto;
  }

  .proun-item__arrow {
    font-size: 1rem;
    color: var(--red);
    opacity: 0.6;
    transition: transform 0.25s ease, opacity 0.25s ease;
  }

  /* ——— Hover states ——— */
  .proun-item:hover {
    transform: rotate(0deg) translateY(-6px);
    box-shadow: -8px 8px 0 var(--color, var(--gold));
    border-color: var(--color, var(--gold));
    z-index: 10;
  }

  .proun-item:hover .proun-item__stripe {
    width: 7px;
  }

  .proun-item:hover .proun-item__hover {
    transform: translateY(0);
  }

  .proun-item:hover .proun-item__arrow {
    transform: translateX(5px);
    opacity: 1;
  }

  /* ——— Decorative Stars (Option 4 blend) ——— */
  .proun-star {
    position: absolute;
    color: var(--red);
    pointer-events: none;
    user-select: none;
    line-height: 1;
    animation: proun-star-float 3.5s ease-in-out infinite;
    will-change: transform, opacity;
  }

  @keyframes proun-star-float {
    0%, 100% { opacity: 0.08; transform: translateY(0) rotate(0deg) scale(1); }
    25% { opacity: 0.22; }
    50% { opacity: 0.12; transform: translateY(-12px) rotate(12deg) scale(1.08); }
    75% { opacity: 0.20; }
  }

  /* ——— Loading ——— */
  .opensource__loading {
    grid-column: 1 / -1;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 8px;
    padding: 56px 0;
    font-family: var(--font-body);
    font-size: 1rem;
    letter-spacing: 0.3em;
    color: var(--black);
    opacity: 0.3;
  }

  .opensource__loading-dot {
    animation: proun-dot-pulse 1.4s ease-in-out infinite;
  }

  .opensource__loading-dot:nth-child(2) {
    animation-delay: 0.2s;
  }

  .opensource__loading-dot:nth-child(3) {
    animation-delay: 0.4s;
  }

  @keyframes proun-dot-pulse {
    0%, 80%, 100% { opacity: 0.2; transform: scale(0.8); }
    40% { opacity: 0.8; transform: scale(1.1); }
  }

  /* ——— Responsive ——— */
  @media (max-width: 768px) {
    .proun-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
    }

    .proun-item--xl {
      grid-column: span 2;
      grid-row: span 1;
      min-height: 100px;
    }

    .proun-item--lg {
      grid-column: span 2;
      min-height: 90px;
    }

    .proun-item--md,
    .proun-item--sm {
      min-height: 85px;
    }

    .proun-item__body {
      padding: 12px 14px 10px 16px;
    }

    .proun-item--xl .proun-item__body {
      padding: 16px 18px 12px 20px;
    }

    .proun-item__name {
      font-size: 0.78rem;
    }

    .proun-item--xl .proun-item__name {
      font-size: 0.95rem;
    }

    .proun-item__hover {
      display: none;
    }

    .proun-grid-bg {
      opacity: 0.18;
    }

    .proun-star {
      display: none;
    }
  }

  @media (max-width: 480px) {
    .proun-grid {
      grid-template-columns: 1fr 1fr;
      gap: 10px;
    }

    .proun-item--xl,
    .proun-item--lg,
    .proun-item--md,
    .proun-item--sm {
      grid-column: span 1;
      min-height: 80px;
    }
  }
</style>

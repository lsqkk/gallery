<section class="opensource section">
  <div class="container">
    <h2 class="section-title" data-reveal>ОТКРЫТЫЙ РЕПОЗИТОРИЙ</h2>
    <p class="opensource__sub" data-reveal>Открытый репозиторий · 开源仓库</p>

    <div class="opensource__grid" id="gh-repos">
      <div class="opensource__loading" id="gh-loading">
        <span class="opensource__loading-dot">●</span>
        <span class="opensource__loading-dot">●</span>
        <span class="opensource__loading-dot">●</span>
      </div>
    </div>
  </div>
</section>

<script>
(function() {
  var EXCLUDED = ['guide-vehicle', 'lsqkk.github.io', 'image', 'lsqkk', 'gallery'];
  var grid = document.getElementById('gh-repos');
  var loading = document.getElementById('gh-loading');

  var LANG_COLORS = {
    'JavaScript': '#f1e05a',
    'TypeScript': '#3178c6',
    'Python': '#3572A5',
    'HTML': '#e34c26',
    'CSS': '#563d7c',
    'Java': '#b07219',
    'C': '#555555',
    'C++': '#f34b7d',
    'Shell': '#89e051',
    'Rust': '#dea584',
    'Go': '#00ADD8',
    'Vue': '#42b883',
    'Astro': '#ff5a03',
  };

  function langColor(lang) {
    return LANG_COLORS[lang] || '#6b6b6b';
  }

  async function loadRepos() {
    try {
      var res = await fetch('https://api.github.com/users/lsqkk/repos?sort=updated&per_page=30&type=owner');
      if (!res.ok) throw new Error('HTTP ' + res.status);
      var repos = await res.json();

      var filtered = repos
        .filter(function(r) { return !EXCLUDED.includes(r.name) && !r.fork; })
        .sort(function(a, b) { return b.stargazers_count - a.stargazers_count; });

      if (filtered.length === 0) {
        loading.textContent = '— No repositories —';
        return;
      }

      loading.style.display = 'none';

      filtered.forEach(function(repo) {
        var card = document.createElement('a');
        card.href = repo.html_url;
        card.target = '_blank';
        card.rel = 'noopener noreferrer';
        card.className = 'repo-card';
        card.setAttribute('data-reveal', '');

        var desc = repo.description || 'No description';

        var html = '<div class="repo-card__top">';
        html += '<h3 class="repo-card__name">' + escapeHtml(repo.name) + '</h3>';
        html += '<div class="repo-card__lang">';
        if (repo.language) {
          html += '<span class="repo-card__dot" style="background:' + langColor(repo.language) + '"></span>';
          html += '<span class="repo-card__lang-text">' + repo.language + '</span>';
        }
        html += '</div>';
        html += '</div>';
        html += '<p class="repo-card__desc">' + escapeHtml(desc) + '</p>';
        html += '<div class="repo-card__meta">';
        html += '<span class="repo-card__stat">&#9733; ' + repo.stargazers_count + '</span>';
        if (repo.forks_count > 0) {
          html += '<span class="repo-card__stat">⑂ ' + repo.forks_count + '</span>';
        }
        html += '<span class="repo-card__updated">' + formatDate(repo.updated_at) + '</span>';
        html += '<span class="repo-card__arrow">→</span>';
        html += '</div>';
        html += '<div class="crop-mark crop-mark--tl"></div>';
        html += '<div class="crop-mark crop-mark--br"></div>';

        card.innerHTML = html;
        grid.appendChild(card);
      });

      // Trigger reveal observer
      requestAnimationFrame(function() {
        var observer = new IntersectionObserver(function(entries) {
          entries.forEach(function(entry) {
            if (entry.isIntersecting) {
              entry.target.classList.add('revealed');
              observer.unobserve(entry.target);
            }
          });
        }, { threshold: 0.08, rootMargin: '0px 0px -40px 0px' });
        grid.querySelectorAll('.repo-card').forEach(function(el) {
          observer.observe(el);
        });
      });

    } catch (err) {
      loading.textContent = '— Failed to load repositories —';
    }
  }

  function formatDate(dateStr) {
    if (!dateStr) return '';
    var d = new Date(dateStr);
    var now = new Date();
    var diff = Math.floor((now - d) / (1000 * 60 * 60 * 24));
    if (diff === 0) return 'today';
    if (diff === 1) return 'yesterday';
    if (diff < 30) return diff + 'd ago';
    return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
  }

  function escapeHtml(str) {
    var div = document.createElement('div');
    div.appendChild(document.createTextNode(str));
    return div.innerHTML;
  }

  loadRepos();
})();
</script>

<style>
  .opensource__sub {
    font-family: var(--font-body);
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--gold-dark);
    margin-bottom: 3rem;
    margin-top: -1.8rem;
  }

  .opensource__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 20px;
  }

  /* ---- Repo Card ---- */
  .repo-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 10px;
    border: 2px solid var(--black);
    padding: 24px 24px 18px;
    background: var(--white-warm);
    text-decoration: none;
    color: inherit;
    min-height: 140px;
    opacity: 0;
    transform: translateY(28px);
    transition: opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1),
                transform 0.6s cubic-bezier(0.16, 1, 0.3, 1),
                box-shadow 0.25s ease,
                border-color 0.25s ease;
  }

  .repo-card.revealed {
    opacity: 1;
    transform: translateY(0);
  }

  .repo-card:hover {
    box-shadow: -5px 5px 0 var(--gold);
    border-color: var(--gold);
  }

  .repo-card__top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 12px;
  }

  .repo-card__name {
    font-family: var(--font-body);
    font-size: clamp(0.95rem, 1.2vw, 1.1rem);
    font-weight: 700;
    letter-spacing: 0.01em;
    color: var(--black);
    text-transform: none;
    margin: 0;
    line-height: 1.3;
    word-break: break-word;
  }

  .repo-card__lang {
    display: flex;
    align-items: center;
    gap: 5px;
    flex-shrink: 0;
    margin-top: 3px;
  }

  .repo-card__dot {
    display: inline-block;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .repo-card__lang-text {
    font-family: var(--font-body);
    font-size: 0.7rem;
    font-weight: 500;
    color: var(--black);
    opacity: 0.6;
  }

  .repo-card__desc {
    font-size: clamp(0.78rem, 0.9vw, 0.85rem);
    color: var(--black);
    opacity: 0.55;
    line-height: 1.55;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    flex: 1;
  }

  .repo-card__meta {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-top: 4px;
    flex-wrap: wrap;
    border-top: 1px solid rgba(17, 17, 17, 0.08);
    padding-top: 10px;
  }

  .repo-card__stat {
    font-family: var(--font-body);
    font-size: 0.72rem;
    font-weight: 500;
    color: var(--black);
    opacity: 0.5;
    letter-spacing: 0.02em;
    display: inline-flex;
    align-items: center;
    gap: 3px;
  }

  .repo-card__updated {
    font-family: var(--font-body);
    font-size: 0.65rem;
    font-weight: 400;
    color: var(--black);
    opacity: 0.35;
    margin-right: auto;
  }

  .repo-card__arrow {
    font-size: 1rem;
    color: var(--gold);
    opacity: 0.35;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .repo-card:hover .repo-card__arrow {
    transform: translateX(5px);
    opacity: 0.8;
  }

  /* ---- Loading dots ---- */
  .opensource__loading {
    grid-column: 1 / -1;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 8px;
    padding: 48px 0;
    font-family: var(--font-body);
    font-size: 1rem;
    letter-spacing: 0.3em;
    color: var(--black);
    opacity: 0.3;
  }

  .opensource__loading-dot {
    animation: dot-pulse 1.4s ease-in-out infinite;
  }

  .opensource__loading-dot:nth-child(2) {
    animation-delay: 0.2s;
  }

  .opensource__loading-dot:nth-child(3) {
    animation-delay: 0.4s;
  }

  @keyframes dot-pulse {
    0%, 80%, 100% { opacity: 0.2; transform: scale(0.8); }
    40% { opacity: 0.8; transform: scale(1.1); }
  }

  @media (max-width: 640px) {
    .opensource__grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }
    .repo-card {
      padding: 18px 18px 14px;
    }
    .repo-card__desc {
      -webkit-line-clamp: 3;
    }
  }
</style>

<section class="opensource section" id="opensource">
  <div class="container">
    <h2 class="section-title" data-reveal>ОТКРЫТЫЙ РЕПОЗИТОРИЙ</h2>
    <p class="opensource__sub" data-reveal>Открытый репозиторий · 开源仓库</p>
  </div>

  <div class="proun-stage" id="proun-stage">
    <div class="proun-grid-bg" aria-hidden="true"></div>
    <div class="proun-scene" id="proun-scene">
      <div class="proun-cylinder" id="proun-cylinder">
        <div class="opensource__loading" id="gh-loading">
          <span class="opensource__loading-dot">●</span>
          <span class="opensource__loading-dot">●</span>
          <span class="opensource__loading-dot">●</span>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
(function() {
  var EXCLUDED = ['guide-vehicle', 'lsqkk.github.io', 'image', 'lsqkk', 'gallery'];
  var cylinder = document.getElementById('proun-cylinder');
  var loading = document.getElementById('gh-loading');
  var scene = document.getElementById('proun-scene');

  var LANG_COLORS = {
    'JavaScript': '#f1e05a',
    'TypeScript': '#3178c6',
    'Python': '#3572A5',
    'HTML': '#e34c26',
    'CSS': '#563d7c',
    'Java': '#b07219',
    'C': '#555555',
    'C++': '#f34b7d',
    'Shell': '#89e051',
    'Rust': '#dea584',
    'Go': '#00ADD8',
    'Vue': '#42b883',
    'Astro': '#ff5a03',
  };

  function langColor(lang) {
    return LANG_COLORS[lang] || '#6b6b6b';
  }

  function shuffle(arr) {
    for (var i = arr.length - 1; i > 0; i--) {
      var j = Math.floor(Math.random() * (i + 1));
      var t = arr[i]; arr[i] = arr[j]; arr[j] = t;
    }
    return arr;
  }

  async function loadRepos() {
    try {
      var res = await fetch('https://api.github.com/users/lsqkk/repos?sort=updated&per_page=100&type=owner');
      if (!res.ok) throw new Error('HTTP ' + res.status);
      var repos = await res.json();

      var all = repos
        .filter(function(r) { return !EXCLUDED.includes(r.name) && !r.fork; })
        .sort(function(a, b) { return b.stargazers_count - a.stargazers_count; });

      var count = all.length;

      if (count === 0) {
        loading.textContent = '— No repositories —';
        return;
      }

      loading.style.display = 'none';

      // ——— DYNAMIC LAYOUT ———
      // Calculate column count and cylinder radius so gap stays ~70px
      var minCols = Math.ceil(count / 3);
      var idealCols = Math.ceil(count / 2.2);
      var COLS = Math.min(20, Math.max(minCols, idealCols));

      // R = chord / (2·sin(π/COLS))  where chord = 140px card + 70px gap = 210px
      var R = Math.round(210 / (2 * Math.sin(Math.PI / COLS)));
      R = Math.min(680, Math.max(280, R));

      cylinder.style.setProperty('--R-desktop', R + 'px');
      scene.style.setProperty('--perspective', Math.round(R * 2.3) + 'px');

      // Distribute cards across columns: start all 1, promote 1→2 then 2→3
      var dist = new Array(COLS).fill(1);
      var remaining = count - COLS;
      // Phase 1: promote 1→2
      var p1 = Math.min(remaining, COLS);
      for (var i = 0; i < p1; i++) dist[i] = 2;
      remaining -= p1;
      // Phase 2: promote 2→3
      var j = 0;
      while (remaining > 0 && j < COLS) {
        if (dist[j] < 3) { dist[j] = 3; remaining--; }
        j++;
      }
      shuffle(dist);

      var cardIdx = 0;
      var ANGLE_STEP = 360 / COLS;

      for (var p = 0; p < COLS && cardIdx < count; p++) {
        var n = dist[p];
        if (!n) continue;

        var colAngle = p * ANGLE_STEP + (Math.random() - 0.5) * Math.min(8, ANGLE_STEP * 0.3);

        var ys = n === 3 ? [-120, 0, 120]
               : n === 2 ? [-60, 60]
               : [0];

        for (var k = 0; k < n && cardIdx < count; k++, cardIdx++) {
          var repo = all[cardIdx];
          var yPos = ys[Math.min(k, ys.length - 1)] + (Math.random() - 0.5) * 16;
          var angle = colAngle + (Math.random() - 0.5) * Math.min(3, ANGLE_STEP * 0.15);
          var colAccent = langColor(repo.language);

          var item = document.createElement('a');
          item.href = repo.html_url;
          item.target = '_blank';
          item.rel = 'noopener noreferrer';
          item.className = 'proun-item';
          item.style.setProperty('--a', angle.toFixed(1) + 'deg');
          item.style.setProperty('--y', yPos.toFixed(0) + 'px');
          item.style.setProperty('--col', colAccent);

          var shortName = repo.name.length > 16 ? repo.name.slice(0, 14) + '…' : repo.name;
          var desc = repo.description || '—';

          item.innerHTML =
            '<span class="proun-item__stripe" style="background:' + colAccent + '"></span>' +
            '<span class="proun-item__inner">' +
              '<span class="proun-item__top">' +
                '<span class="proun-item__name">' + escapeHtml(shortName) + '</span>' +
                '<span class="proun-item__stars">★ ' + repo.stargazers_count + '</span>' +
              '</span>' +
              (repo.language ? '<span class="proun-item__lang"><span class="proun-item__dot" style="background:' + colAccent + '"></span>' + repo.language + '</span>' : '') +
              '<span class="proun-item__desc">' + escapeHtml(desc) + '</span>' +
            '</span>' +
            '<span class="crop-mark crop-mark--tl"></span>' +
            '<span class="crop-mark crop-mark--br"></span>';

          item.addEventListener('mouseenter', function() { isPaused = true; });
          item.addEventListener('mouseleave', function() { isPaused = false; });
          cylinder.appendChild(item);
        }
      }

      // Stars
      var starCount = Math.min(36, Math.max(12, Math.round(count * 0.8)));
      for (var s = 0; s < starCount; s++) {
        var star = document.createElement('span');
        star.className = 'proun-star';
        star.textContent = '★';
        star.style.left = (1 + Math.random() * 98) + '%';
        star.style.top = (2 + Math.random() * 96) + '%';
        star.style.fontSize = (4 + Math.random() * 18) + 'px';
        star.style.animationDelay = (Math.random() * 8).toFixed(2) + 's';
        star.style.animationDuration = (3 + Math.random() * 5).toFixed(1) + 's';
        scene.appendChild(star);
      }

      // Rotation — 0.13°/frame
      var rotation = 0, isPaused = false, isDragging = false;
      var dragStartX = 0, dragStartRot = 0;
      var SPEED = 0.13;

      function tick() {
        if (!isPaused && !isDragging) rotation = (rotation + SPEED) % 360;
        cylinder.style.setProperty('--rot', rotation.toFixed(2) + 'deg');
        requestAnimationFrame(tick);
      }
      requestAnimationFrame(tick);

      scene.addEventListener('mousedown', function(e) {
        if (e.target.closest('a')) return;
        isDragging = true; isPaused = true;
        dragStartX = e.clientX; dragStartRot = rotation;
      });
      window.addEventListener('mousemove', function(e) {
        if (!isDragging) return;
        rotation = ((dragStartRot + (e.clientX - dragStartX) * 0.5) % 360 + 360) % 360;
      });
      window.addEventListener('mouseup', function() { if (isDragging) { isDragging = false; isPaused = false; } });
      scene.addEventListener('touchstart', function(e) {
        if (e.target.closest('a')) return;
        isDragging = true; isPaused = true;
        dragStartX = e.touches[0].clientX; dragStartRot = rotation;
      }, { passive: true });
      scene.addEventListener('touchmove', function(e) {
        if (!isDragging) return;
        rotation = ((dragStartRot + (e.touches[0].clientX - dragStartX) * 0.5) % 360 + 360) % 360;
      }, { passive: true });
      scene.addEventListener('touchend', function() { if (isDragging) { isDragging = false; isPaused = false; } });

    } catch (err) {
      loading.textContent = '— Failed to load repositories —';
    }
  }

  function escapeHtml(str) {
    var div = document.createElement('div');
    div.appendChild(document.createTextNode(str));
    return div.innerHTML;
  }

  loadRepos();
})();
</script>

<style is:global>
  .opensource__sub {
    font-family: var(--font-body);
    font-size: 0.95rem; font-weight: 500;
    letter-spacing: 0.2em; text-transform: uppercase;
    color: var(--gold-dark);
    margin-bottom: 3rem; margin-top: -1.8rem;
  }

  /* ============================================
     Proun Stage
     Dynamic R (set by JS as --R-desktop)
     Card: 140×90px | 0 empty columns
     ============================================ */
  .proun-stage {
    position: relative; max-width: 1260px;
    margin: 0 auto; padding: 0 4vw;
    height: 560px; overflow: visible;
    transform: translateZ(0);
    will-change: transform;
  }

  .proun-grid-bg {
    position: absolute; inset: 0; pointer-events: none;
    opacity: 0.12;
    background-image:
      repeating-linear-gradient(28deg, transparent 0px, transparent 39px, rgba(196,164,74,0.05) 40px),
      repeating-linear-gradient(-28deg, transparent 0px, transparent 39px, rgba(196,164,74,0.05) 40px);
  }

  .proun-scene {
    position: absolute; inset: 0;
    perspective: var(--perspective, 1000px);
    perspective-origin: 50% 46%;
    display: flex; align-items: center; justify-content: center;
    cursor: grab;
  }
  .proun-scene:active { cursor: grabbing; }

  .proun-cylinder {
    --R: var(--R-desktop, 440px);
    width: 0; height: 0;
    transform-style: preserve-3d;
    transform: rotateY(var(--rot, 0deg));
  }

  /* ——— Card ——— */
  .proun-item {
    position: absolute;
    display: block;
    width: 140px;
    height: 90px;
    margin-left: -70px;
    margin-top: calc(-45px + var(--y, 0px));
    backface-visibility: hidden;
    transform: rotateY(var(--a, 0deg)) translateZ(var(--R));
    text-decoration: none; color: inherit;
    border: 2px solid var(--black);
    background: var(--white-warm);
    box-shadow: -2px 2px 0 rgba(17,17,17,0.06);
    cursor: pointer;
    transition: transform 0.3s cubic-bezier(0.16,1,0.3,1),
                box-shadow 0.25s ease,
                border-color 0.2s ease;
  }

  .proun-item:hover {
    transform: rotateY(var(--a,0deg)) translateZ(var(--R)) scale(1.15);
    box-shadow: -8px 8px 0 var(--col, var(--gold));
    border-color: var(--col, var(--gold));
    z-index: 999;
  }
  .proun-item:hover .proun-item__stripe { width: 4px; }

  .proun-item__stripe {
    position: absolute; top: 0; left: 0;
    width: 3px; height: 100%;
    transition: width 0.25s cubic-bezier(0.16,1,0.3,1);
  }

  .proun-item__inner {
    display: flex; flex-direction: column;
    height: 100%;
    padding: 8px 12px 6px 14px;
    position: relative;
    overflow: hidden;
  }

  .proun-item__top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 4px;
    flex-shrink: 0;
  }

  .proun-item__name {
    font-family: var(--font-display);
    font-size: 0.62rem;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--black);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    line-height: 1.2;
    min-width: 0;
  }

  .proun-item__stars {
    font-family: var(--font-body);
    font-size: 0.52rem;
    font-weight: 600;
    color: var(--gold-dark);
    white-space: nowrap;
    flex-shrink: 0;
    margin-top: 1px;
  }

  .proun-item__lang {
    display: inline-flex; align-items: center; gap: 3px;
    font-family: var(--font-body);
    font-size: 0.48rem; font-weight: 500;
    color: var(--black); opacity: 0.35;
    margin-top: 1px;
    flex-shrink: 0;
  }

  .proun-item__dot {
    display: inline-block;
    width: 4px; height: 4px;
    border-radius: 50%; flex-shrink: 0;
  }

  .proun-item__desc {
    font-family: var(--font-body);
    font-size: 0.48rem;
    color: var(--black); opacity: 0.72;
    margin: 2px 0 0;
    line-height: 1.3;
    flex: 1;
    min-height: 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    word-break: break-word;
  }

  /* ============================================
     Red Stars
     ============================================ */
  .proun-star {
    position: absolute; color: var(--red);
    pointer-events: none; user-select: none; line-height: 1;
    animation: star-drift 4.5s ease-in-out infinite;
    will-change: transform, opacity;
    text-shadow: 0 0 12px rgba(204,0,0,0.25);
    z-index: 3;
  }
  @keyframes star-drift {
    0%,100% { opacity: 0.04; transform: translateY(0) scale(1); }
    35% { opacity: 0.18; transform: translateY(-5px) scale(1.08); }
    65% { opacity: 0.09; transform: translateY(-2px) scale(1.02); }
  }

  /* ============================================
     Loading
     ============================================ */
  .opensource__loading {
    position: absolute; left: 50%; top: 50%;
    transform: translate(-50%,-50%);
    display: flex; gap: 8px;
    font-family: var(--font-body); font-size: 1rem;
    letter-spacing: 0.3em; color: var(--black); opacity: 0.25;
  }
  .opensource__loading-dot { animation: dot-pulse 1.4s ease-in-out infinite; }
  .opensource__loading-dot:nth-child(2) { animation-delay: 0.2s; }
  .opensource__loading-dot:nth-child(3) { animation-delay: 0.4s; }
  @keyframes dot-pulse {
    0%,80%,100% { opacity: 0.2; transform: scale(0.8); }
    40% { opacity: 0.8; transform: scale(1.1); }
  }

  /* ============================================
     Responsive
     ============================================ */
  @media (max-width: 860px) {
    .proun-stage { height: 400px; }
    .proun-scene { perspective: 800px; }
    .proun-cylinder { --R: 320px; }
    .proun-item { width: 100px; height: 68px; margin-left: -50px; margin-top: calc(-34px + var(--y,0px)); }
    .proun-item__inner { padding: 5px 8px 4px 10px; }
    .proun-item__name { font-size: 0.5rem; }
    .proun-item__stars { font-size: 0.42rem; }
    .proun-item__lang { font-size: 0.4rem; }
    .proun-item__desc { font-size: 0.4rem; -webkit-line-clamp: 2; }
    .proun-star { display: none; }
  }

  @media (max-width: 540px) {
    .proun-stage { height: 280px; }
    .proun-scene { perspective: 550px; perspective-origin: 50% 42%; }
    .proun-cylinder { --R: 220px; }
    .proun-item { width: 72px; height: 50px; margin-left: -36px; margin-top: calc(-25px + var(--y,0px)); border-width: 1.5px; }
    .proun-item__inner { padding: 3px 6px 2px 8px; }
    .proun-item__name { font-size: 0.38rem; }
    .proun-item__stars { font-size: 0.32rem; }
    .proun-item__lang { display: none; }
    .proun-item__desc { font-size: 0.34rem; -webkit-line-clamp: 1; margin-top: 1px; }
    .proun-item__stripe { width: 2px; }
    .proun-item:hover { transform: rotateY(var(--a)) translateZ(var(--R)) scale(1.08); box-shadow: -3px 3px 0 var(--col, var(--gold)); }
    .proun-item .crop-mark { width: 7px; height: 7px; border-width: 1.5px; }
    .proun-item .crop-mark--tl { border-width: 1.5px 0 0 1.5px; }
    .proun-item .crop-mark--br { border-width: 0 1.5px 1.5px 0; }
  }
</style>

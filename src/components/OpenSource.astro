<section class="opensource section">
  <div class="container">
    <h2 class="section-title" data-reveal>ОТКРЫТЫЙ РЕПОЗИТОРИЙ</h2>
    <p class="opensource__sub" data-reveal>Открытый репозиторий · 开源仓库</p>

    <div class="opensource__grid" id="gh-repos">
      <div class="opensource__loading" id="gh-loading">
        <span class="opensource__loading-dot">●</span>
        <span class="opensource__loading-dot">●</span>
        <span class="opensource__loading-dot">●</span>
      </div>
    </div>
  </div>
</section>

<script>
(function() {
  const EXCLUDED = ['guide-vehicle', 'lsqkk.github.io', 'image', 'lsqkk', 'gallery'];
  const grid = document.getElementById('gh-repos');
  const loading = document.getElementById('gh-loading');

  const LANG_COLORS = {
    'JavaScript': '#f1e05a',
    'TypeScript': '#3178c6',
    'Python': '#3572A5',
    'HTML': '#e34c26',
    'CSS': '#563d7c',
    'Java': '#b07219',
    'C': '#555555',
    'C++': '#f34b7d',
    'Shell': '#89e051',
    'Rust': '#dea584',
    'Go': '#00ADD8',
    'Vue': '#42b883',
    'Astro': '#ff5a03',
  };

  function langColor(lang) {
    return LANG_COLORS[lang] || '#6b6b6b';
  }

  async function loadRepos() {
    try {
      const res = await fetch('https://api.github.com/users/lsqkk/repos?sort=updated&per_page=30&type=owner');
      if (!res.ok) throw new Error('HTTP ' + res.status);
      const repos = await res.json();

      const filtered = repos
        .filter(r => !EXCLUDED.includes(r.name) && !r.fork)
        .sort((a, b) => b.stargazers_count - a.stargazers_count);

      if (filtered.length === 0) {
        loading.textContent = '— Нет репозиториев —';
        return;
      }

      loading.style.display = 'none';

      filtered.forEach(function(repo) {
        var card = document.createElement('a');
        card.href = repo.html_url;
        card.target = '_blank';
        card.rel = 'noopener noreferrer';
        card.className = 'repo-card';
        card.setAttribute('data-reveal', '');

        var desc = repo.description || '—';

        var html = '<div class="repo-card__body">';
        html += '<h3 class="repo-card__name">' + repo.name + '</h3>';
        html += '<p class="repo-card__desc">' + escapeHtml(desc) + '</p>';
        html += '</div>';
        html += '<div class="repo-card__meta">';
        if (repo.language) {
          html += '<span class="repo-card__lang"><span class="repo-card__dot" style="background:' + langColor(repo.language) + '"></span>' + repo.language + '</span>';
        }
        html += '<span class="repo-card__stars">&#9733; ' + repo.stargazers_count + '</span>';
        if (repo.forks_count > 0) {
          html += '<span class="repo-card__forks">⑂ ' + repo.forks_count + '</span>';
        }
        html += '<span class="repo-card__arrow">→</span>';
        html += '</div>';
        html += '<div class="crop-mark crop-mark--tl"></div>';
        html += '<div class="crop-mark crop-mark--br"></div>';

        card.innerHTML = html;
        grid.appendChild(card);
      });

      // Trigger reveal on newly added cards
      requestAnimationFrame(function() {
        var observer = new IntersectionObserver(function(entries) {
          entries.forEach(function(entry) {
            if (entry.isIntersecting) {
              entry.target.classList.add('revealed');
              observer.unobserve(entry.target);
            }
          });
        }, { threshold: 0.08, rootMargin: '0px 0px -40px 0px' });

        grid.querySelectorAll('.repo-card').forEach(function(el) {
          observer.observe(el);
        });
      });

    } catch (err) {
      loading.textContent = '— Не удалось загрузить репозитории —';
    }
  }

  function escapeHtml(str) {
    var div = document.createElement('div');
    div.appendChild(document.createTextNode(str));
    return div.innerHTML;
  }

  loadRepos();
})();
</script>

<style>
  .opensource__sub {
    font-family: var(--font-body);
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--gold-dark);
    margin-bottom: 3rem;
    margin-top: -1.8rem;
  }

  .opensource__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 16px;
  }

  /* ---- Repo Card ---- */
  .repo-card {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    border: 2px solid var(--black);
    padding: 20px;
    background: var(--white-warm);
    text-decoration: none;
    color: inherit;
    min-height: 150px;
    opacity: 0;
    transform: translateY(28px);
    transition: opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1),
                transform 0.6s cubic-bezier(0.16, 1, 0.3, 1),
                box-shadow 0.25s ease;
  }

  .repo-card.revealed {
    opacity: 1;
    transform: translateY(0);
  }

  .repo-card:hover {
    box-shadow: -4px 4px 0 var(--gold);
    border-color: var(--gold);
  }

  .repo-card__body {
    flex: 1;
  }

  .repo-card__name {
    font-family: var(--font-body);
    font-size: clamp(0.85rem, 1.1vw, 1rem);
    font-weight: 600;
    letter-spacing: 0.02em;
    margin-bottom: 0.4rem;
    color: var(--black);
    text-transform: none;
  }

  .repo-card__desc {
    font-size: clamp(0.7rem, 0.85vw, 0.8rem);
    color: var(--black);
    opacity: 0.5;
    line-height: 1.5;
    max-width: 95%;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .repo-card__meta {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 1rem;
    flex-wrap: wrap;
  }

  .repo-card__lang {
    font-family: var(--font-body);
    font-size: 0.65rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    color: var(--black);
    opacity: 0.7;
  }

  .repo-card__dot {
    display: inline-block;
    width: 8px;
    height: 8px;
    border-radius: 50%;
  }

  .repo-card__stars,
  .repo-card__forks {
    font-family: var(--font-body);
    font-size: 0.65rem;
    font-weight: 500;
    color: var(--black);
    opacity: 0.55;
    letter-spacing: 0.03em;
  }

  .repo-card__arrow {
    margin-left: auto;
    font-size: 0.9rem;
    color: var(--gold);
    opacity: 0.4;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .repo-card:hover .repo-card__arrow {
    transform: translateX(4px);
    opacity: 0.8;
  }

  /* ---- Loading dots ---- */
  .opensource__loading {
    grid-column: 1 / -1;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 6px;
    padding: 40px 0;
    font-family: var(--font-body);
    font-size: 1rem;
    letter-spacing: 0.3em;
    color: var(--black);
    opacity: 0.3;
  }

  .opensource__loading-dot {
    animation: dot-pulse 1.4s ease-in-out infinite;
  }

  .opensource__loading-dot:nth-child(2) {
    animation-delay: 0.2s;
  }

  .opensource__loading-dot:nth-child(3) {
    animation-delay: 0.4s;
  }

  @keyframes dot-pulse {
    0%, 80%, 100% { opacity: 0.2; transform: scale(0.8); }
    40% { opacity: 0.8; transform: scale(1.1); }
  }

  @media (max-width: 640px) {
    .opensource__grid {
      grid-template-columns: 1fr;
    }
    .repo-card__desc {
      -webkit-line-clamp: 3;
    }
  }
</style>

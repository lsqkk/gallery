<!-- Fixed Suprematist geometric composition — visible behind all content -->
<div class="layer-fixed" aria-hidden="true">
  <!-- 1. Large red triangle, right side, pointing down-left -->
  <div class="geo geo-triangle" data-parallax="0.45"></div>

  <!-- 2. Black square, rotated, upper-left -->
  <div class="geo geo-square"></div>

  <!-- 3. Clock ring — visible only behind content -->
  <div class="geo geo-ring" id="geo-ring">
    <div class="clock-face" id="clock-face">
      <div class="clock-hand clock-hour" id="clock-hour"></div>
      <div class="clock-hand clock-minute" id="clock-minute"></div>
      <div class="clock-hand clock-second" id="clock-second"></div>
      <div class="clock-pin"></div>
    </div>
    <div class="clock-digital" id="clock-digital">00:00</div>
  </div>

  <!-- 4. Gold horizontal bar — visible only behind content -->
  <div class="geo geo-bar-h" id="geo-bar-h">
    <div class="bar-pivot" aria-hidden="true"></div>
  </div>

  <!-- 5. Vertical thin line, left -->
  <div class="geo geo-bar-v" data-parallax="0.55"></div>

  <!-- 6. Small red square accent, lower-right -->
  <div class="geo geo-accent-1" data-parallax="0.2"></div>

  <!-- 7. Black circle accent, center-left -->
  <div class="geo geo-accent-2" data-parallax="0.6"></div>

  <!-- 8. Diagonal red line, center -->
  <div class="geo geo-diagonal"></div>

  <!-- 9. Registration mark (印刷套准标记) upper-right -->
  <div class="geo geo-regmark" data-parallax="0.35">
    <div class="regmark-circle"></div>
    <div class="regmark-cross-h"></div>
    <div class="regmark-cross-v"></div>
  </div>

  <!-- 10. Cyrillic watermark — very faint, fills background -->
  <div class="geo geo-watermark" data-parallax="0.65">ГАЛЕРЕЯ</div>

  <!-- 11. Second watermark — parallax layer -->
  <div class="geo geo-watermark-2" data-parallax="0.15">СОВЕТСКИЙ</div>
</div>

<!-- Invisible hit targets — above content, capture mouse events for background elements -->
<div class="layer-interactive" aria-hidden="true">
  <!-- 3a. Clock hit target — invisible, same position as geo-ring -->
  <div class="ring-ht" id="ring-ht"></div>

  <!-- 4a. Bar hit target — invisible, same position as geo-bar-h -->
  <div class="bar-ht" id="bar-ht"></div>
</div>

<script>
(function() {
  'use strict';

  /* ========== CLOCK ========== */
  var hourHand = document.getElementById('clock-hour');
  var minHand = document.getElementById('clock-minute');
  var secHand = document.getElementById('clock-second');
  var clockDigital = document.getElementById('clock-digital');
  var ringEl = document.getElementById('geo-ring');
  var ringHT = document.getElementById('ring-ht');

  if (hourHand) {
    function tick() {
      var now = new Date();
      var h = now.getHours() % 12;
      var m = now.getMinutes();
      var s = now.getSeconds();

      hourHand.style.transform = 'rotate(' + (h * 30 + m * 0.5) + 'deg)';
      minHand.style.transform = 'rotate(' + (m * 6 + s * 0.1) + 'deg)';
      secHand.style.transform = 'rotate(' + (s * 6) + 'deg)';

      if (clockDigital) {
        var hh = String(now.getHours()).padStart(2, '0');
        var mm = String(now.getMinutes()).padStart(2, '0');
        clockDigital.textContent = hh + ':' + mm;
      }
    }
    tick();
    setInterval(tick, 1000);
  }

  // Clock hover: invisible hit target controls visible ring
  if (ringHT && ringEl) {
    ringHT.addEventListener('mouseenter', function() { ringEl.classList.add('ring-active'); });
    ringHT.addEventListener('mouseleave', function() { ringEl.classList.remove('ring-active'); });
    // Touch support
    ringHT.addEventListener('touchstart', function() { ringEl.classList.add('ring-active'); }, { passive: true });
    ringHT.addEventListener('touchend', function() { ringEl.classList.remove('ring-active'); });
  }

  /* ========== DRAGGABLE GOLD BAR ========== */
  var barVis = document.getElementById('geo-bar-h');
  var barHT = document.getElementById('bar-ht');

  if (barVis && barHT) {
    var isDragging = false;
    var dragAngle = 0;
    var pivotX = 0, pivotY = 0;
    var startAngleOffset = 0;
    var springId = null;

    // Bar hover: invisible hit target controls visible bar-pivot
    barHT.addEventListener('mouseenter', function() { barVis.classList.add('bar-active'); });
    barHT.addEventListener('mouseleave', function() { barVis.classList.remove('bar-active'); });

    function onStart(e) {
      var cx = e.clientX || (e.touches && e.touches[0].clientX);
      var cy = e.clientY || (e.touches && e.touches[0].clientY);
      if (cx == null) return;

      // Cancel any running spring immediately
      if (springId) { cancelAnimationFrame(springId); springId = null; }

      // Temporarily clear transform to get natural bounding rect,
      // then restore — happens in the same JS frame, no visual flicker.
      // This prevents pivot drift when the bar is still rotated from
      // a previous drag that hasn't fully settled.
      var saved = barVis.style.transform;
      barVis.style.transform = '';
      var rect = barVis.getBoundingClientRect();
      pivotX = rect.left + rect.width * 0.9;
      pivotY = rect.top + rect.height / 2;
      barVis.style.transform = saved;

      startAngleOffset = Math.atan2(cy - pivotY, cx - pivotX) * (180 / Math.PI) - dragAngle;
      isDragging = true;
      barVis.style.cursor = 'grabbing';
      barHT.style.cursor = 'grabbing';
      if (e.cancelable) e.preventDefault();
    }

    function onMove(e) {
      if (!isDragging) return;
      var cx = e.clientX || (e.touches && e.touches[0].clientX);
      var cy = e.clientY || (e.touches && e.touches[0].clientY);
      if (cx == null) return;

      var raw = Math.atan2(cy - pivotY, cx - pivotX) * (180 / Math.PI) - startAngleOffset;
      dragAngle = Math.max(-100, Math.min(100, raw));
      barVis.style.transform = 'rotate(' + dragAngle + 'deg)';
    }

    function onEnd() {
      if (!isDragging) return;
      isDragging = false;
      barVis.style.cursor = '';
      barHT.style.cursor = 'grab';

      var pos = dragAngle;
      var vel = 0;
      var STIFFNESS = 0.03;
      var DAMPING = 0.85;

      function spring() {
        var force = -STIFFNESS * pos;
        vel = (vel + force) * DAMPING;
        pos += vel;

        barVis.style.transform = 'rotate(' + pos + 'deg)';

        if (Math.abs(pos) > 0.4 || Math.abs(vel) > 0.1) {
          springId = requestAnimationFrame(spring);
        } else {
          barVis.style.transform = '';
          dragAngle = 0;
          springId = null;
        }
      }
      springId = requestAnimationFrame(spring);
    }

    barHT.addEventListener('mousedown', onStart);
    document.addEventListener('mousemove', onMove);
    document.addEventListener('mouseup', onEnd);
    barHT.addEventListener('touchstart', onStart, { passive: true });
    document.addEventListener('touchmove', onMove, { passive: true });
    document.addEventListener('touchend', onEnd);
  }
})();
</script>

<style>
  /* ---- Triangle (right side) ---- */
  .geo-triangle {
    width: 50vw;
    height: 75vh;
    top: 12vh;
    right: 0;
    background: var(--red);
    clip-path: polygon(100% 0, 100% 100%, 25% 100%);
    opacity: 0.85;
    animation: breathe 10s ease-in-out infinite;
  }

  /* ---- Black Square (rotated) ---- */
  .geo-square {
    width: 170px;
    height: 170px;
    top: 14%;
    left: 2%;
    background: var(--gold);
    opacity: 0.3;
    transform: rotate(28deg);
    animation: slow-spin 150s linear infinite;
  }

  /* ---- Interactive Layer (transparent, only contains hit targets) ---- */
  .layer-interactive {
    position: fixed;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    overflow: hidden;
  }

  /* ---- Clock Ring (visible, behind content) ---- */
  .geo-ring {
    width: 300px;
    height: 300px;
    bottom: -4%;
    left: -3%;
    border: 16px solid var(--black);
    border-radius: 50%;
    opacity: 0.7;
  }

  .clock-face {
    position: absolute;
    inset: 20px;
    border-radius: 50%;
    transition: opacity 0.35s ease;
  }

  .geo-ring.ring-active .clock-face {
    opacity: 0;
  }

  .clock-hand {
    position: absolute;
    bottom: 50%;
    left: 50%;
    transform-origin: bottom center;
    border-radius: 2px;
  }

  .clock-hour {
    width: 4px;
    height: 28%;
    background: var(--black);
    margin-left: -2px;
  }

  .clock-minute {
    width: 2.5px;
    height: 38%;
    background: var(--black);
    margin-left: -1.25px;
  }

  .clock-second {
    width: 1.5px;
    height: 44%;
    background: var(--red);
    margin-left: -0.75px;
  }

  .clock-pin {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 6px;
    height: 6px;
    margin: -3px;
    background: var(--red);
    border-radius: 50%;
    z-index: 1;
  }

  .clock-digital {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    font-family: var(--font-display);
    font-size: 1.8rem;
    letter-spacing: 0.1em;
    color: var(--black);
    opacity: 0;
    transition: opacity 0.35s ease;
    pointer-events: none;
    background: rgba(237, 232, 221, 0.85);
    padding: 4px 10px;
    border-radius: 2px;
  }

  .geo-ring.ring-active .clock-digital {
    opacity: 1;
  }

  /* ---- Clock Hit Target (invisible) ---- */
  .ring-ht {
    position: absolute;
    width: 300px;
    height: 300px;
    bottom: -4%;
    left: -3%;
    border-radius: 50%;
    pointer-events: auto;
    cursor: default;
  }

  /* ---- Gold Horizontal Bar (visible, behind content) ---- */
  .geo-bar-h {
    width: 22%;
    height: 16px;
    top: 12%;
    right: 16%;
    background: var(--gold);
    transform-origin: 90% center;
    position: absolute;
  }

  .bar-pivot {
    position: absolute;
    right: 10%;
    top: 50%;
    width: 10px;
    height: 10px;
    margin: -5px 0 0 -5px;
    background: var(--red);
    border-radius: 50%;
    opacity: 0.3;
    pointer-events: none;
    transition: opacity 0.2s ease;
  }

  .geo-bar-h.bar-active .bar-pivot {
    opacity: 0.6;
  }

  /* ---- Bar Hit Target (invisible, slightly taller for easier grabbing) ---- */
  .bar-ht {
    position: absolute;
    width: 22%;
    height: 24px;
    top: 12%;
    right: 16%;
    pointer-events: auto;
    cursor: grab;
  }

  .bar-ht:active {
    cursor: grabbing;
  }

  /* ---- Vertical Thin Line ---- */
  .geo-bar-v {
    width: 4px;
    height: 50%;
    left: 86%;
    top: 10%;
    background: var(--gold-dark);
    opacity: 0.4;
  }

  /* ---- Small Red Square ---- */
  .geo-accent-1 {
    width: 32px;
    height: 32px;
    bottom: 22%;
    right: 14%;
    background: var(--red);
  }

  /* ---- Black Circle ---- */
  .geo-accent-2 {
    width: 52px;
    height: 52px;
    top: 56%;
    left: 28%;
    background: var(--black);
    border-radius: 50%;
    opacity: 0.6;
  }

  /* ---- Diagonal Red Line ---- */
  .geo-diagonal {
    width: 4px;
    height: 28%;
    top: 50%;
    left: 68%;
    background: var(--red);
    transform: rotate(-42deg);
    transform-origin: top center;
  }

  /* ---- Registration Mark ---- */
  .geo-regmark {
    width: 56px;
    height: 56px;
    top: 10%;
    right: 12%;
  }
  .regmark-circle {
    position: absolute;
    inset: 4px;
    border: 2px solid var(--black);
    border-radius: 50%;
  }
  .regmark-cross-h, .regmark-cross-v {
    position: absolute;
    background: var(--black);
  }
  .regmark-cross-h {
    width: 100%;
    height: 1px;
    top: 50%;
    transform: translateY(-50%);
  }
  .regmark-cross-v {
    height: 100%;
    width: 1px;
    left: 50%;
    transform: translateX(-50%);
  }

  /* ---- Cyrillic Watermark (fixed) ---- */
  .geo-watermark {
    font-family: var(--font-display);
    font-size: clamp(12rem, 32vw, 26rem);
    color: rgba(17, 17, 17, 0.035);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    white-space: nowrap;
    user-select: none;
    line-height: 1;
  }

  /* ---- Cyrillic Watermark 2 (parallax) ---- */
  .geo-watermark-2 {
    font-family: var(--font-display);
    font-size: clamp(6rem, 16vw, 12rem);
    color: rgba(196, 164, 74, 0.04);
    text-transform: uppercase;
    letter-spacing: 0.3em;
    bottom: 15%;
    right: -5%;
    white-space: nowrap;
    user-select: none;
    line-height: 1;
  }

  /* ---- Responsive adjustments ---- */
  @media (max-width: 768px) {
    .geo-triangle { width: 70vw; height: 50vh; top: 30vh; }
    .geo-square { width: 100px; height: 100px; top: 10%; }
    .geo-ring { width: 180px; height: 180px; border-width: 10px; }
    .ring-ht { width: 180px; height: 180px; }
    .clock-digital { font-size: 1.1rem; padding: 2px 6px; }
    .clock-face { inset: 12px; }
    .geo-bar-h { height: 12px; width: 30%; top: 12%; right: 18%; }
    .bar-ht { height: 20px; width: 30%; top: 12%; right: 18%; }
    .geo-bar-v { left: 92%; }
    .geo-regmark { right: 6%; }
  }

  /* ---- Subtle Animations ---- */
  @keyframes slow-spin {
    from { transform: rotate(28deg); }
    to   { transform: rotate(388deg); }
  }

  @keyframes breathe {
    0%, 100% { opacity: 0.85; }
    50%      { opacity: 0.65; }
  }
</style>

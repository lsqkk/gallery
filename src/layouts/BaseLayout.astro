---
import '../styles/global.css';
import TopBar from '../components/TopBar.astro';

export interface Props {
  title?: string;
  description?: string;
}

const { title = '蓝色奇夸克的 Gallery', description = '无穷的远方，无数的人们，都和我有关' } = Astro.props;
---

<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Rubik:wght@400;500;600;700;800&family=Staatliches&display=swap" rel="stylesheet" />
</head>
<body>
  <div class="texture-overlay" aria-hidden="true"></div>
  <TopBar />
  <slot />

  <script>
    (() => {
      'use strict';

      // Helper
      const $ = (s) => [...document.querySelectorAll(s)];

      // --- Immediately reveal above-fold elements ---
      $('[data-reveal]').forEach((el) => {
        if (el.getBoundingClientRect().top < window.innerHeight) {
          const d = el.getAttribute('data-reveal-delay');
          if (d) el.style.transitionDelay = `${d}s`;
          el.classList.add('revealed');
        }
      });

      // --- Parallax System ---
      const parallaxEls = $('[data-parallax]');

      function updateParallax() {
        const vh = window.innerHeight;
        for (const el of parallaxEls) {
          const speed = parseFloat(el.getAttribute('data-parallax')) || 0;
          const rect = el.getBoundingClientRect();
          const center = rect.top + rect.height / 2;
          const dist = (center / vh - 0.5) * 2;
          const clamped = Math.max(-0.8, Math.min(0.8, dist));
          const offset = clamped * vh * (1 - speed) * 0.2;
          el.style.transform = `translateY(${-offset}px)`;
        }
      }

      let ticking = false;
      window.addEventListener('scroll', () => {
        if (!ticking) {
          requestAnimationFrame(() => {
            updateParallax();
            ticking = false;
          });
          ticking = true;
        }
      }, { passive: true });

      // --- Reveal Observer for below-fold elements ---
      const revealEls = $('[data-reveal]:not(.revealed)');
      if (revealEls.length) {
        const observer = new IntersectionObserver((entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              const el = entry.target;
              const delay = el.getAttribute('data-reveal-delay');
              if (delay) el.style.transitionDelay = `${delay}s`;
              el.classList.add('revealed');
              observer.unobserve(el);
            }
          }
        }, { threshold: 0.08, rootMargin: '0px 0px -40px 0px' });
        revealEls.forEach((el) => observer.observe(el));
      }

      // Initialise
      updateParallax();
    })();
  </script>

  <script>
    (function() {
      var MAX = 120;
      var active = 0;
      var COLORS = ['#CC0000', '#C4A44A', '#111111', '#EDE8DD', '#8B0000'];
      var STARS = ['★', '✦', '✧', '☆'];

      document.addEventListener('click', function(e) {
        var tag = e.target.tagName;
        if (tag === 'A' || tag === 'BUTTON' || tag === 'INPUT' || tag === 'TEXTAREA') return;

        var count = 10 + Math.floor(Math.random() * 12);
        for (var i = 0; i < count; i++) {
          if (active >= MAX) break;
          active++;

          var el = document.createElement('div');
          el.textContent = STARS[Math.floor(Math.random() * STARS.length)];
          el.style.cssText = 'position:fixed;z-index:99999;pointer-events:none;color:' + COLORS[Math.floor(Math.random() * COLORS.length)] + ';font-size:' + (4 + Math.random() * 8) + 'px;left:' + e.clientX + 'px;top:' + e.clientY + 'px;transform:translate(-50%,-50%);opacity:1;line-height:1;user-select:none';
          document.body.appendChild(el);

          var angle = Math.random() * Math.PI * 2;
          var speed = 50 + Math.random() * 200;
          var vx = Math.cos(angle) * speed;
          var vy = Math.sin(angle) * speed - 60;
          var gravity = 100 + Math.random() * 100;
          var rot = (Math.random() - 0.5) * 720;
          var life = 400 + Math.random() * 800;
          var delay = Math.random() * 80;
          var start = performance.now() + delay;

          if (delay > 0) el.style.opacity = '0';

          (function(el, sx, sy, vx, vy, gr, rt, lt, st) {
            function anim(now) {
              var t = (now - st) / 1000;
              if (t < 0) { requestAnimationFrame(anim); return; }
              var p = t / (lt / 1000);
              if (p >= 1) { if (el.parentNode) el.remove(); active--; return; }
              el.style.left = (sx + vx * t) + 'px';
              el.style.top = (sy + vy * t + 0.5 * gr * t * t) + 'px';
              el.style.transform = 'translate(-50%,-50%) rotate(' + (rt * p) + 'deg) scale(' + (1 - p * 0.4) + ')';
              el.style.opacity = Math.max(0, 1 - p * p);
              requestAnimationFrame(anim);
            }
            requestAnimationFrame(anim);
          })(el, e.clientX, e.clientY, vx, vy, gravity, rot, life, start);
        }
      });
    })();
  </script>
</body>
</html>
